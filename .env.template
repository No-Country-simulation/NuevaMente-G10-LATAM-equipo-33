# NuevaMente: plantilla pública para Windows 10/11 y Python 3.12.
# Copiar a .env solo si aún no existe. No reemplazar un .env ya configurado.
# Los marcadores TU_... y ..._DE_EJEMPLO deben sustituirse cuando se utilicen.

# Gemini: completar con claves reales separadas por comas, sin compartir este archivo.
# Vacío impide arrancar el Backend porque RAG exige al menos una clave.
GEMINI_API_KEYS=""
# Modelos de referencia del proyecto; comprobar acceso y cuota en la cuenta utilizada.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_RESPALDO=gemini-3.8-flash
# Opcionales: dejar comentados para heredar la selección general.
# GEMINI_EVALUATION_MODEL=MODELO_JUEZ_DE_EJEMPLO
# GEMINI_EVALUATION_MODEL_RESPALDO=MODELO_RESPALDO_JUEZ_DE_EJEMPLO
# Un respaldo específico vacío desactiva el respaldo del juez.

# RAG y embeddings: el máximo efectivo es cuatro intentos por lote.
MODELO_EMBEDDINGS=gemini-embedding-001
MAX_EMBEDDING_ATTEMPTS=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
CHROMA_PERSIST_DIR=./chroma_db
NOMBRE_COLECCION=nuevamente_documentos

# Aplicación y API. API_HOST/API_PORT no sustituyen los argumentos de Uvicorn.
APP_NAME=NuevaMente
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
MAX_UPLOAD_MB=10

# Cliente HTTP de Streamlit. Reiniciar ambos procesos después de cambiar el entorno.
BACKEND_URL=http://localhost:8000
API_TIMEOUT_SECONDS=300

# Elegir local u oci. Local no necesita credenciales Oracle, pero sí acceso a Gemini.
STORAGE_BACKEND=local
DOCUMENTS_PATH=./data/documents
GENERATED_PATH=./data/generated

# Solo para STORAGE_BACKEND=oci. Nunca incluir claves privadas ni OCID reales aquí.
OCI_CONFIG_FILE=./.oci/config
OCI_PROFILE=DEFAULT
OCI_NAMESPACE=TU_NAMESPACE
OCI_BUCKET_NAME=TU_BUCKET
OCI_AUTH_MODE=api_key
# Vacío conserva la región del perfil .oci/config; un valor la reemplaza.
OCI_REGION=""
